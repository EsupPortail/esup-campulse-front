{
  "name": "plana",
  "version": "1.6.6",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:test": "vue-tsc --noEmit && NODE_ENV=development vite build --mode deploy_test",
    "build:pprd": "vue-tsc --noEmit && NODE_ENV=production vite build --mode deploy_pprd",
    "build:prod": "vue-tsc --noEmit && NODE_ENV=production vite build --mode deploy_prod",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --fix --cache",
    "preview": "vite preview --port 5050",
    "test:unit": "vitest --environment jsdom",
    "test:unit:coverage": "vitest --environment jsdom --coverage",
    "test:unit:ui": "vitest --environment jsdom --ui",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "prepare": "husky"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.9",
    "@quasar/extras": "^1.18.0",
    "@sentry/vue": "^11.17.0",
    "@vue-unistra/cas-authentication": "^2.3.1",
    "axios": "^1.21.1",
    "bootstrap-icons": "^1.13.2",
    "dompurify": "^3.5.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.6",
    "sass": "^1.108.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.23",
    "vue-matomo": "^4.2.0",
    "vue-router": "^5.3.1",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@babel/types": "^7.29.15",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@pinia/testing": "^2.0.2",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "oxlint": "~1.82.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
